# ── Core ──
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agriksense
# Public base URL used to build signed file links
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ── Secrets (generate with: openssl rand -hex 32) ──
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# 32-byte key, hex (64 chars) — encrypts NIN/CAC/bank numbers
DATA_ENCRYPTION_KEY=
# HMAC key for lookup hashes and signed file URLs
HASH_KEY=
FILE_URL_TTL_SECONDS=300

# ── Storage ──
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760

# ── Identity verification: "manual" (reviewer decides) or "mock" (deterministic, dev/test only) ──
VERIFICATION_PROVIDER=manual

# ── Google OAuth ──
GOOGLE_CLIENT_ID=

# ── AI inference: "http" calls the model services, "mock" returns deterministic detections ──
AI_INFERENCE_MODE=http
AI_PREDICT_PATH=/predict
AI_UPLOAD_FIELD=file
AI_HEALTH_PATH=/health
AI_TIMEOUT_MS=60000
# Confidence scale returned by the services: unit (0-1) or percent (0-100)
AI_CONFIDENCE_SCALE=unit
AI_RICE_URL=https://rice-disease-api-vzxa.onrender.com
AI_MAIZE_URL=https://maize-disease-api.onrender.com
AI_TOMATO_URL=https://tomato-disease-api-w8if.onrender.com

# ── Fare calculation ──
# Multiplier applied to straight-line (haversine) distance to approximate road distance
FARE_ROAD_FACTOR=1.3

# ── Notifications ──
# "log" prints messages; real providers plug into src/services/notification.service.ts
NOTIFICATION_PROVIDER=log
# Shared secret for verifying /integrations/notifications/webhooks/{provider} (HMAC-SHA256 hex of raw body in X-Signature)
NOTIFICATION_WEBHOOK_SECRET=

# ── Seed: initial platform admin ──
SEED_ADMIN_EMAIL=admin@agriksense.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
